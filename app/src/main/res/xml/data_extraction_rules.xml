<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Данные приложения не должны покидать устройство: ни в облако, ни при переносе. -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
